# =============================================================================
# Cal.diy / Cal.com API v2 - AWS Lightsail environment template
# =============================================================================
# Copy this file to .env.aws locally (or /home/ubuntu/cal-diy/.env on the
# server) and replace every <PLACEHOLDER>.
#
# On the Lightsail instance, this file MUST live next to docker-compose.yml:
#   /home/ubuntu/cal-diy/.env
#   /home/ubuntu/cal-diy/docker-compose.yml   (content of docker-compose-aws.yml)
#
# RULES:
#   - Do NOT wrap values in quotes. Docker Compose strips them, but
#     `docker run --env-file` passes them literally and Node.js fails with
#     "invalid value for NODE_OPTIONS".
#   - Do NOT use the `export` keyword.
#   - Inline comments are NOT supported. A `#` starts a comment only at the
#     beginning of a line. Values containing `#` must be URL-encoded.
#   - This file must never be committed with real values. Keep chmod 600.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Stable compose project name (containers/volumes keep the same prefix).
COMPOSE_PROJECT_NAME=cal-diy

NODE_ENV=development

# The API reads API_PORT, NOT PORT. Default when unset is 5555, which would
# leave the container unreachable on the published 3000.
API_PORT=3000

# --- Public URLs (replace <STATIC_IP> with your Lightsail Static IP) ---------
NEXT_PUBLIC_WEBAPP_URL=http://<STATIC_IP>:3001
WEB_APP_URL=http://<STATIC_IP>:3001
NEXT_PUBLIC_API_V2_URL=http://<STATIC_IP>:3000/api/v2
API_URL=http://<STATIC_IP>:3000

# --- Database (external PostgreSQL, e.g. Neon) -------------------------------
# Neon: Dashboard > Project > Connect. Use the POOLED host for DATABASE_URL and
# the DIRECT host (suffix "-pooler" removed) for DATABASE_DIRECT_URL.
DATABASE_URL=postgresql://USERNAME:PASSWORD@<NEON_POOLED_HOST>/<DATABASE>?sslmode=require
DATABASE_DIRECT_URL=postgresql://USERNAME:PASSWORD@<NEON_DIRECT_HOST>/<DATABASE>?sslmode=require
# Required by apps/api/v2/src/config/app.ts (no fallback: the app refuses to
# boot if they are missing). Point both to the pooled connection.
DATABASE_READ_URL=postgresql://USERNAME:PASSWORD@<NEON_POOLED_HOST>/<DATABASE>?sslmode=require
DATABASE_WRITE_URL=postgresql://USERNAME:PASSWORD@<NEON_POOLED_HOST>/<DATABASE>?sslmode=require

# Legacy: only needed by the local Postgres service in docker-compose-aws.yml.
# Ignore these when using Neon (the calcom/calcom-api services read DATABASE_URL).
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=<LOCAL_POSTGRES_PASSWORD>
POSTGRES_DB=neondb

# --- Redis (compose service "redis", internal Docker network) ----------------
REDIS_URL=redis://redis:6379

# --- Secrets (generate each one with the command shown) ----------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=<GENERATE_ME>
# openssl rand -base64 32
JWT_SECRET=<GENERATE_ME>
# openssl rand -base64 24  -> exactly 32 characters
CALENDSO_ENCRYPTION_KEY=<GENERATE_ME>

# --- Cal.com settings --------------------------------------------------------
CALCOM_TELEMETRY_DISABLED=true
NEXT_PUBLIC_LICENSE_CONSENT=true
API_KEY_PREFIX=cal_
LOG_LEVEL=info
ENABLE_SLOTS_WORKERS=true

# --- Stripe (optional; leave empty if unused) --------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMTP (use an app password, never your account password) -----------------
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=notifications@example.com
EMAIL_SERVER_PASSWORD=<SMTP_APP_PASSWORD>
EMAIL_FROM=Cal.diy <notifications@example.com>

# --- Node / process ----------------------------------------------------------
# Keep at 2048 on a 4 GB instance that also runs the web app and Redis.
NODE_OPTIONS=--max-old-space-size=2048
WEB_CONCURRENCY=1

# --- TLS / proxy -------------------------------------------------------------
# NODE_TLS_REJECT_UNAUTHORIZED=0 disables TLS certificate verification for the
# whole process (MITM risk). Only acceptable for a throwaway/dummy environment.
SSL_ENABLED=false
NODE_TLS_REJECT_UNAUTHORIZED=0
EXPRESS_TRUST_PROXY=false
NO_HTTPS=true

# --- Swagger ----------------------------------------------------------------
SWAGGER_CUSTOM_SITE_TITLE=Cal.com API
SWAGGER_CUSTOM_CSS_URL=/docs/swagger-ui.css
SWAGGER_CUSTOM_JS=/docs/swagger-ui-bundle.js
