# ==========================================
# STAGE 1: Base & Dependencies
# ==========================================
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /calcom

# Copiar todo el monorepo para resolver dependencias compartidas y Workspaces
COPY . .

# Instalar todas las dependencias
RUN yarn install

# ==========================================
# STAGE 2: Builder
# ==========================================
FROM node:20-alpine AS builder
WORKDIR /calcom

COPY --from=deps /calcom ./

ENV NODE_ENV=production
# Desactivar la comprobación de tipos estricta durante el empaquetado de produccion
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_BUILD_STATIC_GENERATION=true
ENV NEST_CLI_BUILD_NO_TYPE_CHECK=true

# Construir omitiendo verificaciones de tipos estrictas globales
RUN yarn workspace @calcom/api-v2 build

# ==========================================
# STAGE 3: Runner (Imagen de Producción)
# ==========================================
FROM node:20-alpine AS runner
WORKDIR /calcom

ENV NODE_ENV=production
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copiar la estructura del monorepo compilado
COPY --from=builder --chown=nestjs:nodejs /calcom/package.json ./package.json
COPY --from=builder --chown=nestjs:nodejs /calcom/yarn.lock ./yarn.lock
COPY --from=builder --chown=nestjs:nodejs /calcom/.yarn ./.yarn
COPY --from=builder --chown=nestjs:nodejs /calcom/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /calcom/packages ./packages
COPY --from=builder --chown=nestjs:nodejs /calcom/apps/api/v2 ./apps/api/v2

USER nestjs

EXPOSE 3000

CMD ["yarn", "workspace", "@calcom/api-v2", "start"]